# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend.vercel.app

# Neon PostgreSQL (use the pooled DATABASE_URL from Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Frontend origins (comma-separated if more than one)
CORS_ALLOWED_ORIGINS=https://key-two-alpha.vercel.app
CSRF_TRUSTED_ORIGINS=https://key-two-alpha.vercel.app
